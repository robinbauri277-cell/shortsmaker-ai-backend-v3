# Copy to .env for local use. On Render, set these in the dashboard instead.
# Never commit real secrets.

PORT=10000
NODE_ENV=production

# Comma-separated list of exact origins allowed to call the API (no trailing slash).
# Blogger can serve your blog from a country domain such as .in or .co.uk,
# so add the one you actually see in the browser address bar.
CORS_ORIGINS=https://shortsmakerhub.blogspot.com,https://shortsmakerhub.blogspot.in

# Optional: absolute public URL of this backend, used when building download links.
# Leave empty to derive it from the request.
PUBLIC_BASE_URL=https://shortsmaker-ai-backend-1.onrender.com

# Limits
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=3600
MAX_CLIP_SECONDS=120
MAX_CLIP_COUNT=5
PROCESS_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=10
JOB_TTL_MINUTES=60
FFMPEG_THREADS=2
VERIFY_DECODE=true

# Rate limits (per IP)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=60

# Where temporary uploads and clips are stored (ephemeral on Render unless a disk is attached).
# DATA_DIR=/tmp/shortsmaker-data

# Only if ffmpeg/ffprobe are not on PATH:
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- RESERVED for later stages. NOT read by the current code. ---
# GEMINI_API_KEY=
# GEMINI_MODEL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
